# build directories (one per backend, so they coexist for A/B testing)
build/
build-*/

# python
.venv/
__pycache__/
*.pyc

# model artifacts and parity data. The convention throughout is ref*/ for a torch dump and
# cpp*/ for ours, compared with tools/cossim.py -- both are scratch.
# Anchored: unanchored, cpp*/ also matched vendor/cpp-httplib/, so the vendored
# httplib was never committed and a fresh clone could not configure.
models/
/ref*/
/cpp*/
*.gguf
*.wav
*.f32
*.npy

# local audio fixtures (bring your own; see docs/MELODYFLOW_VAE.md)
testdata/
